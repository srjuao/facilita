# Copy this file to .env for local development. Never commit .env.
# Use distinct, strong values in each environment and provide production secrets
# through the deployment platform's secret store.

PORT=3001
JWT_SECRET=replace-with-a-cryptographically-random-secret-at-least-32-bytes
CORS_ORIGIN=https://app.facilitaestudos.com.br
DATABASE_URL=postgresql://facilita:replace-with-a-strong-password@localhost:5432/facilita?schema=public
