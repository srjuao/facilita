datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum LeadStage {
  NOVO
  CONTATO
  PROPOSTA
  GANHO
  PERDIDO
}

model Lead {
  id          String    @id @default(cuid())
  nome        String
  instituicao String
  email       String
  telefone    String
  alunos      Int?
  mensagem    String    @default("")
  stage       LeadStage @default(NOVO)
  notas       String    @default("")
  consentAt   DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([createdAt])
  @@index([stage])
}

model Tenant {
  id        String   @id
  nome      String
  full      String
  cidade    String
  color     String
  cover     String
  dominio   String   @unique
  admin     String
  since     String
  ativo     Boolean  @default(true)
  desativadoEm DateTime?
  logoUrl   String   @default("")
  loginImageUrl String @default("")
  faviconUrl String @default("")
  browserTitle String @default("")
  loginKicker String @default("")
  loginTitle String @default("")
  loginDescription String @default("")
  primaryColor String @default("#2f7dd1")
  courses   Course[]
  users     User[]
  departments Department[]
  academicPeriods AcademicPeriod[]
  announcements Announcement[]
  classGroups ClassGroup[]
  conversations Conversation[]
  planId    String?
  plan      Plan? @relation(fields: [planId], references: [id], onDelete: Restrict)
  billingContract PlatformContract?
  platformInvoices PlatformInvoice[]
  tuitionSettings TuitionSettings?
  tuitionAdjustments TuitionAdjustment[]
  tuitionInvoices TuitionInvoice[]
  liveSessions LiveSession[]
  certificateTemplates CertificateTemplate[]
  certificateIssues CertificateIssue[]
}

model TuitionSettings {
  tenantId String @id
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  mode String
  schoolCents Int
  dueDay Int
  startMonth String
  issuerName String
  issuerDocument String
  issuerAddress String
  paymentInstructions String
  coursePrices Json
  version Int @default(0)
  updatedBy String
  updatedAt DateTime @updatedAt
}

model TuitionAdjustment {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId String
  discountCents Int @default(0)
  scholarship Boolean @default(false)
  startMonth String
  updatedBy String
  updatedAt DateTime @updatedAt
  @@unique([tenantId, studentId])
}

model TuitionInvoice {
  id String @id @default(cuid())
  number String @unique
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId String
  studentName String
  studentEmail String
  courseId String?
  courseName String?
  mode String
  competence String
  dueDate DateTime
  grossCents Int
  discountCents Int
  totalCents Int
  status String @default("OPEN")
  issuerName String
  issuerDocument String
  issuerAddress String
  paymentInstructions String
  settingsVersion Int
  version Int @default(0)
  paidAt DateTime?
  createdAt DateTime @default(now())
  events TuitionInvoiceEvent[]
  @@unique([tenantId, studentId, competence])
  @@index([tenantId, id])
  @@index([tenantId, studentId, id])
}

model TuitionInvoiceEvent {
  id String @id @default(cuid())
  invoiceId String
  invoice TuitionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  action String
  note String
  actorId String
  actorName String
  createdAt DateTime @default(now())
}

model PlatformContract {
  tenantId String @id
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  minimumStudents Int
  unitCents Int
  dueDay Int
  closingDay Int @default(1)
  billingName String
  billingDocument String
  billingAddress String
  billingEmail String
  issuerName String
  issuerDocument String
  issuerAddress String
  paymentInstructions String
  version Int @default(0)
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformInvoice {
  id String @id @default(cuid())
  number String @unique
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  competence String
  dueDate DateTime
  closingDate DateTime
  closingDay Int @default(1)
  minimumStudents Int
  activeStudents Int
  billableStudents Int
  unitCents Int
  totalCents Int
  contractVersion Int
  billingName String
  billingDocument String
  billingAddress String
  billingEmail String
  issuerName String
  issuerDocument String
  issuerAddress String
  paymentInstructions String
  status String @default("OPEN")
  version Int @default(0)
  createdAt DateTime @default(now())
  paidAt DateTime?
  events PlatformInvoiceEvent[]
  @@unique([tenantId, competence])
  @@index([createdAt])
}

model PlatformInvoiceEvent {
  id String @id @default(cuid())
  invoiceId String
  invoice PlatformInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  action String
  note String
  actorId String
  actorName String
  createdAt DateTime @default(now())
  @@index([invoiceId, createdAt])
}

enum BillingMode {
  FIXO
  POR_ALUNO
  FAIXAS
}

model Plan {
  id           String @id @default(cuid())
  nome         String
  descricao    String @default("")
  billingMode  BillingMode
  priceCents   Int
  studentLimit Int?
  defaultMinimumStudents Int?
  videoAulas   Boolean
  provas       Boolean
  ia           Boolean
  ativo        Boolean @default(true)
  createdAt    DateTime @default(now())
  tenants      Tenant[]
  pricePoints  PlanPoint[]
  publicPricing PublicPricingSetting[]
}

model PlanPoint {
  planId String
  students Int
  unitCents Int
  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)
  @@id([planId, students])
}

model PublicPricingSetting {
  id Int @id @default(1)
  planId String?
  plan Plan? @relation(fields: [planId], references: [id], onDelete: Restrict)
}

model Course {
  id        String   @id
  nome      String
  status    String
  alunos    Int      @default(0)
  previstos Int      @default(0)
  periodos  Int      @default(0)
  ucs       Int      @default(0)
  aulas     Int      @default(0)
  preco     Float    @default(0)
  adesao    Float    @default(0)
  piloto    Boolean  @default(false)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  modules   Module[]
  students  Student[]
  exams     Exam[]
  users     User[]
  classGroups ClassGroup[]
  academicPeriods AcademicPeriod[]
  paidContent Boolean @default(false)
  contentPriceCents Int @default(0)
  saleVersion Int @default(0)
  entitlements CourseEntitlement[]
  accessEvents CourseAccessEvent[]
  accessRequests CourseAccessRequest[]
  liveSessions LiveSession[]
}

model User {
  disabledAt DateTime?
  examAttempts ExamAttempt[]
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  nome      String
  papel     String
  role      String   // superadmin, coord, aluno
  photo     Int      @default(0)
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id])
  studentId Int?     @unique
  student   Student? @relation(fields: [studentId], references: [id])
  permissions String[] @default([])
  departmentId String?
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  announcements Announcement[]
  conversations Conversation[]
  conversationMessages ConversationMessage[]
  courseEntitlements CourseEntitlement[] @relation("EntitledStudent")
  grantedCourseEntitlements CourseEntitlement[] @relation("EntitlementActor")
  courseAccessRequests CourseAccessRequest[]
  courseAccessEvents CourseAccessEvent[] @relation("AccessStudent")
  authoredCourseAccessEvents CourseAccessEvent[] @relation("AccessActor")
  createdLiveSessions LiveSession[]
  facilitatedLiveRooms LiveRoom[] @relation("LiveRoomFacilitator")
  lessonCompletions LessonCompletion[]
  certificateIssues CertificateIssue[]
}

model CourseEntitlement {
  id String @id @default(cuid())
  courseId String
  userId String
  active Boolean @default(true)
  reason String
  actorId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  user User @relation("EntitledStudent", fields: [userId], references: [id], onDelete: Restrict)
  actor User @relation("EntitlementActor", fields: [actorId], references: [id], onDelete: Restrict)
  @@unique([courseId, userId])
  @@index([userId, active])
}

model CourseAccessEvent {
  id String @id @default(cuid())
  courseId String
  userId String
  actorId String
  action String
  reason String
  createdAt DateTime @default(now())
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  user User @relation("AccessStudent", fields: [userId], references: [id], onDelete: Restrict)
  actor User @relation("AccessActor", fields: [actorId], references: [id], onDelete: Restrict)
  @@index([courseId, userId, createdAt])
}

model CourseAccessRequest {
  id String @id @default(cuid())
  courseId String
  userId String
  quotedPriceCents Int
  createdAt DateTime @default(now())
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([courseId, userId])
  @@index([userId])
}

model Department {
  archivedAt DateTime?
  updatedAt DateTime @default(now()) @updatedAt
  id String @id @default(cuid())
  tenantId String
  nome String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users User[]
  @@unique([tenantId, nome])
}

model AcademicPeriod {
  archivedAt DateTime?
  updatedAt DateTime @default(now()) @updatedAt
  id String @id @default(cuid())
  tenantId String
  courseId String
  nome String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  modules Module[]
  classGroups ClassGroup[]
  @@index([tenantId, courseId])
}

model Announcement {
  archivedAt DateTime?
  updatedAt DateTime @default(now()) @updatedAt
  id String @id @default(cuid())
  tenantId String
  title String
  body String
  createdBy String
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  @@index([tenantId, createdAt])
}

model ClassGroup {
  archivedAt DateTime?
  updatedAt DateTime @default(now()) @updatedAt
  id String @id @default(cuid())
  tenantId String
  courseId String
  periodId String?
  nome String
  memberIds String[] @default([])
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  period AcademicPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  liveSessions LiveSession[]
  @@index([tenantId, courseId])
  @@index([periodId])
}

model LiveSession {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courseId String?
  course Course? @relation(fields: [courseId], references: [id], onDelete: Restrict)
  classGroupId String?
  classGroup ClassGroup? @relation(fields: [classGroupId], references: [id], onDelete: Restrict)
  rooms LiveRoom[]
  roomSize Int @default(30)
  title String
  startsAt DateTime
  endsAt DateTime
  status String @default("scheduled")
  createdBy String
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  startedAt DateTime?
  endedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenantId, startsAt])
  @@index([tenantId, status])
  @@index([courseId])
  @@index([classGroupId])
}

model LiveRoom {
  id String @id @default(cuid())
  sessionId String
  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ordinal Int
  label String
  memberIds String[] @default([])
  facilitatorId String?
  facilitator User? @relation("LiveRoomFacilitator", fields: [facilitatorId], references: [id], onDelete: SetNull)
  @@unique([sessionId, ordinal])
  @@index([facilitatorId])
  @@index([memberIds], type: Gin)
}

model Conversation {
  archivedAt DateTime?
  updatedAt DateTime @default(now()) @updatedAt
  id String @id @default(cuid())
  tenantId String
  nome String
  memberIds String[] @default([])
  createdBy String
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  messages ConversationMessage[]
  @@index([tenantId, createdAt])
}

model ConversationMessage {
  id String @id @default(cuid())
  conversationId String
  senderId String
  body String
  createdAt DateTime @default(now())
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Restrict)
  @@index([conversationId, createdAt])
}

model Student {
  id           Int           @id @default(autoincrement())
  nome         String
  sub          String
  progresso    Int
  nota         Float
  tempo        Int
  ultimo       Int
  risco        String
  online       Boolean       @default(false)
  atividade    String        // Armazenado como JSON string do array [tipo, texto, modId]
  desde        Int           @default(0)
  usoProva     Float         @default(0)
  flash        Int           @default(0)
  acerto       Int           @default(0)
  weeks        String        // Armazenado como JSON array string
  notas        String        // Armazenado como JSON obj string
  tempos       String        // Armazenado como JSON obj string
  courseId     String
  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user         User?
  chatMessages ChatMessage[]
}

model Module {
  archivedAt DateTime?
  updatedAt DateTime @default(now()) @updatedAt
  id       String   @id
  nome     String
  desc     String
  img      String
  color    String
  aulas    Int
  lista    String   // Armazenado como JSON string do array de aulas
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]
  finalExamId String? @unique
  finalExam Exam? @relation("ModuleFinalExam", fields: [finalExamId], references: [id], onDelete: SetNull)
  periodId String?
  period AcademicPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
}

model Lesson {
  archivedAt DateTime?
  updatedAt DateTime @default(now()) @updatedAt
  id          String   @id @default(cuid())
  titulo      String
  desc        String
  videoUrl    String
  duracao     String   @default("")
  prof        String   @default("")
  pdfUrl      String?
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  position Int @default(0)
  completions LessonCompletion[]
  attachments LessonAttachment[]
  @@index([moduleId, position])
}

model LessonCompletion {
  userId String
  lessonId String
  completedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  @@id([userId, lessonId])
}

model LessonAttachment {
  id String @id @default(cuid())
  lessonId String
  filename String
  storageName String
  mimeType String
  size Int
  createdAt DateTime @default(now())
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  @@index([lessonId])
}

model CertificateTemplate {
  id String @id @default(cuid())
  tenantId String
  scope String
  targetId String
  enabled Boolean @default(false)
  title String
  issuer String
  signatory String
  signatoryRole String
  workloadHours Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  issues CertificateIssue[]
  @@unique([tenantId, scope, targetId])
}

model CertificateIssue {
  id String @id @default(cuid())
  code String @unique
  templateId String
  tenantId String
  userId String
  scope String
  targetId String
  issuedAt DateTime @default(now())
  snapshot Json
  template CertificateTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([userId, scope, targetId])
  @@index([tenantId, issuedAt])
}

model Exam {
  published Boolean @default(false)
  archivedAt DateTime?
  maxAttempts Int @default(1)
  passingScore Float @default(7)
  version Int @default(0)
  attempts ExamAttempt[]
  id       String     @id @default(cuid())
  nome     String
  data     String
  q        Int
  feitos   Int        @default(0)
  media    Float?
  tempo    Int?
  dificil  String     @default("—")
  futura   Boolean    @default(false)
  courseId String
  course   Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions Question[]
  finalForModule Module? @relation("ModuleFinalExam")
}

model Question {
  archivedAt DateTime?
  id         Int    @id @default(autoincrement())
  topic      String
  enunciado  String
  alts       String // JSON string Array de alternativas
  correta    Int
  comentario String
  erro       Int    @default(0)
  dist       String @default("[]") // JSON string Array
  examId     String?
  exam       Exam?  @relation(fields: [examId], references: [id])
  courseId   String?
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String   // user ou ai (me / ai)
  content   String
  createdAt DateTime @default(now())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model ExamAttempt {
  id String @id @default(cuid())
  submissionId String
  examId String
  userId String
  number Int
  score Float
  correct Int
  total Int
  passed Boolean
  snapshot Json
  createdAt DateTime @default(now())
  exam Exam @relation(fields: [examId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([examId, userId, number])
  @@unique([userId, submissionId])
  @@index([userId, createdAt])
}
