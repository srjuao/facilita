datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id      String   @id
  nome    String
  full    String
  cidade  String
  color   String
  cover   String
  dominio String   @unique
  admin   String
  since   String
  courses Course[]
  users   User[]
}

model Course {
  id        String    @id
  nome      String
  status    String
  alunos    Int       @default(0)
  previstos Int       @default(0)
  periodos  Int       @default(0)
  ucs       Int       @default(0)
  aulas     Int       @default(0)
  preco     Float     @default(0)
  adesao    Float     @default(0)
  piloto    Boolean   @default(false)
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  modules   Module[]
  students  Student[]
  exams     Exam[]
  users     User[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  nome      String
  papel     String
  role      String // superadmin, coord, aluno
  photo     Int      @default(0)
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id])
  studentId Int?     @unique
  student   Student? @relation(fields: [studentId], references: [id])
}

model Student {
  id           Int           @id @default(autoincrement())
  nome         String
  sub          String
  progresso    Int
  nota         Float
  tempo        Int
  ultimo       Int
  risco        String
  online       Boolean       @default(false)
  atividade    String // Armazenado como JSON string do array [tipo, texto, modId]
  desde        Int           @default(0)
  usoProva     Float         @default(0)
  flash        Int           @default(0)
  acerto       Int           @default(0)
  weeks        String // Armazenado como JSON array string
  notas        String // Armazenado como JSON obj string
  tempos       String // Armazenado como JSON obj string
  courseId     String
  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user         User?
  chatMessages ChatMessage[]
}

model Module {
  id       String   @id
  nome     String
  desc     String
  img      String
  color    String
  aulas    Int
  lista    String // Armazenado como JSON string do array de aulas
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]
}

model Lesson {
  id       String  @id @default(cuid())
  titulo   String
  desc     String
  videoUrl String
  duracao  String  @default("45 min")
  prof     String  @default("Prof. Dr. Sérgio Amaral")
  pdfUrl   String?
  moduleId String
  module   Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model Exam {
  id        String     @id @default(cuid())
  nome      String
  data      String
  q         Int
  feitos    Int        @default(0)
  media     Float?
  tempo     Int?
  dificil   String     @default("—")
  futura    Boolean    @default(false)
  courseId  String
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions Question[]
}

model Question {
  id         Int     @id @default(autoincrement())
  topic      String
  enunciado  String
  alts       String // JSON string Array de alternativas
  correta    Int
  comentario String
  erro       Int     @default(0)
  dist       String  @default("[]") // JSON string Array
  examId     String?
  exam       Exam?   @relation(fields: [examId], references: [id])
  courseId   String?
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String // user ou ai (me / ai)
  content   String
  createdAt DateTime @default(now())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}
